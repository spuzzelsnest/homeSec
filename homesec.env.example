# homeSec settings.
# preps.sh installs this as /etc/homesec/homesec.env (readable by root and the "motion" group).
# Plain KEY=value lines: read by systemd (EnvironmentFile) and by the homesec script.
# For development you can also put a copy named ".env" next to homeSec.sh.

# Where the pictures are mailed to (required)
EMAIL="you@example.com"

# Optional: From address (leave empty to let msmtp decide)
#MAIL_FROM="you@gmail.com"

#SUBJECT="Motion detected"

# Folder motion saves pictures in (motion's target_dir). Must be writable by the "motion" user.
# The service may only write to /var/lib/homesec; if you change this, also change
# StateDirectory/ReadWritePaths in homesec.service.
#IMAGE_DIR="/var/lib/homesec"

# Only used by "homesec --test" and when homesec takes a picture itself
#VIDEO_DEVICE="/dev/video0"
#RESOLUTION="1280x720"
#SKIP_FRAMES=10

# Minimum seconds between two e-mails (stops mail floods)
#COOLDOWN=300

# Delete pictures older than this many days
#KEEP_DAYS=7
