# homeSec settings.
# deploy.sh installs this as /etc/homesec/homesec.env (readable by root and the "homesec" user only).
# Plain KEY=value lines, read by systemd (EnvironmentFile) and by the program itself.
# Put values with special characters in single quotes, e.g. SMTP_PASSWORD='p@ss word#1'.
# For development you can keep a copy named ".env" next to homesec.py.
# After editing: sudo systemctl restart homesec

# ---- Mail (required) ----------------------------------------------------------------
# Where the pictures go. Several addresses: a@example.com,b@example.com
MAIL_TO="you@example.com"

SMTP_HOST="smtp.gmail.com"
# starttls (port 587, default), ssl (port 465) or none (port 587, unencrypted: only for a local relay)
#SMTP_SECURITY="starttls"
#SMTP_PORT=587
SMTP_USER="you@gmail.com"
# Gmail needs an app password (2-step verification must be on), not your normal password.
SMTP_PASSWORD='your app password'

# Optional: From address (default: SMTP_USER) and subject (default: "Person detected",
# or "Motion detected" without the person check)
#MAIL_FROM="you@gmail.com"
#MAIL_SUBJECT="Motion detected"

# ---- Camera -------------------------------------------------------------------------
# auto: Pi camera / libcamera camera if one is found, otherwise a USB webcam
# picamera2: force the Pi camera, opencv: force a USB webcam
#CAMERA="auto"
# Size of the mailed picture. Bigger pictures need more camera memory (CMA): if the camera
# fails with "Cannot allocate memory", lower this first (try 1280x720).
#RESOLUTION="1920x1080"
# Picture buffers the camera keeps (2-12). Each one is a full picture in camera memory.
#BUFFER_COUNT=3
# USB webcam only (CAMERA=opencv): device number or path, e.g. 0 or /dev/video0
#VIDEO_DEVICE="0"

# ---- Motion detection ---------------------------------------------------------------
# Size and speed of the small pictures used to detect movement. Low values keep the CPU idle.
#DETECT_SIZE="320x240"
#FPS=5
# Movement = a part of the picture whose PATTERN changes. Light changes (a police car's blue
# light on the wall, lamps, clouds, the camera's own exposure) change brightness, not the
# pattern, and are ignored.
# Smallest moving area that counts, in % of the picture. Raise it (try 2-3) if small things
# such as insects or leaves trigger; lower it (try 0.5) if far-away people are missed.
#MIN_AREA=1.0
# If more than this % of the picture changes at once, it is treated as a light change.
#MAX_AREA=60
# Number of successive frames with movement needed (at 5 fps, 3 frames = 0.6 s)
#FRAMES=3
# Parts of the picture to ignore, in % of the picture: left,top,right,bottom; separate
# several areas with ";". Example: a window top right and a tree on the left:
#MASK="70,0,100,40; 0,20,15,100"
# Seconds after start before movement is reported (camera exposure settles)
#WARMUP=5
# Minimum seconds between two alerts (stops mail floods)
#COOLDOWN=300

# ---- Person check -------------------------------------------------------------------
# When something moves, a small AI model (YOLOX-tiny, runs on the Pi, nothing leaves the
# house) looks at the picture. Only when it sees a person is an alert sent.
# auto: on if OpenCV and the model are installed (deploy.sh does that), otherwise alert on
# every movement; on: refuse to start without it; off: alert on every movement.
#OBJECT_CHECK="auto"
# What to alert on, comma separated, e.g. "person,cat,dog,car" (COCO object names)
#OBJECTS="person"
# How sure the model must be, 0.05-0.99. Lower = fewer missed people, more false alarms.
#OBJECT_CONFIDENCE=0.5
# Seconds between two checks while the movement goes on (keeps the CPU free)
#RECHECK=2
# Keep pictures of movements without a person in IMAGE_DIR/rejected (for tuning)
#KEEP_REJECTED=no
# Model file (default: the one deploy.sh installs)
#OBJECT_MODEL="/usr/local/share/homesec/models/yolox_tiny.onnx"

# ---- Visits (videos, no alert) --------------------------------------------------------
# When the person check sees one of these, homeSec records a video instead of alerting:
# from VIDEO_BEFORE seconds before until VIDEO_AFTER seconds after it was last seen (at most
# VIDEO_MAX seconds). The videos are in the web console under "Visits" and in IMAGE_DIR/visits.
# Comma separated COCO names (bird, cat, dog, ...), or "none" to switch visits off.
# (VIDEO_AFTER: for a visit, seconds after the visitor was last seen; for an alert, after the
# movement stopped.)
#RECORD_OBJECTS="bird"
# Birds are small and quick, so the model is less sure of them. It must see the bird where the
# movement is; a wrong guess only costs a short video.
#VISIT_CONFIDENCE=0.3
# Smallest movement (in % of the picture) that is checked for visitors (alerts use MIN_AREA).
#RECORD_MIN_AREA=0.3
#VIDEO_BEFORE=3
#VIDEO_AFTER=7
#VIDEO_MAX=60
# Frames per second and quality of the videos. 15 fps at 8000 kbit/s is about 1 MB per second.
# In the dark the camera may slow down to FPS to get enough light.
#VIDEO_FPS=15
#VIDEO_KBPS=8000
# Visit videos are kept this many days (alert pictures: KEEP_DAYS)
#VISIT_KEEP_DAYS=30

# ---- Alert video -----------------------------------------------------------------------
# Every alert is also filmed in full resolution: from VIDEO_BEFORE seconds before the alert until
# VIDEO_AFTER seconds after the movement has stopped (at most VIDEO_MAX seconds). Watch it in the
# web console; the alert mail links to it. (VIDEO_FPS and VIDEO_KBPS above set the quality.)
#ALERT_VIDEO=yes

# ---- Alert clip (in the mail) ---------------------------------------------------------
# The alert mail gets a short animated GIF: the seconds before and after the alert, with the
# time on every frame and a red border from the alert on. The mail goes out when the clip is
# complete, CLIP_AFTER seconds after the alert; Slack is told straight away.
#CLIP_BEFORE=3
#CLIP_AFTER=2
# Frames per second in the clip, and its width in pixels (0 = no clip). More frames or a
# bigger clip = bigger mails: 640 px at 2 fps for 5 s is roughly 1-2 MB.
#CLIP_FPS=2
#CLIP_WIDTH=640

# ---- Slack (optional) ---------------------------------------------------------------
# Posts a message when motion is detected. Create an incoming webhook for your Slack app
# (api.slack.com/apps -> Incoming Webhooks) and paste its URL. Keep it secret.
# Test with: sudo -u homesec homesec slacktest
#SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T000/B000/XXXX"
# Slack-app webhooks post to the channel chosen when the webhook was created and may ignore
# this setting; it is also used as the label in the web console.
#SLACK_CHANNEL="#sec-cams"

# ---- Web console ----------------------------------------------------------------------
# Live view, Files, Stats. Behind a login, over https (see Security below).
#WEB_HOST="0.0.0.0"
# WEB_PORT=0 switches the page off. https and plain http share the port: http gets a redirect.
#WEB_PORT=8080
# Address used in the links in Slack messages and mails (default: https://<hostname>.local:<port>)
#WEB_URL="https://pycam.local:8080"
# Extra host names the page may be opened under (comma separated), e.g. a fixed IP address
#WEB_ALLOWED_HOSTS=""
# Folder with index.html, login.html, style.css, app.js (default: the static folder deploy.sh installs)
#STATIC_DIR="/usr/local/share/homesec/static"

# ---- Security -------------------------------------------------------------------------
# Login: logins are made on the Pi with: sudo -u homesec homesec adduser NAME
# (--role viewer: can watch, not delete or pause). LOGIN=no: no login (trusted network only).
#LOGIN=yes
# How long "Keep me signed in" lasts, in hours (720 = 30 days; without it: 12 hours)
#SESSION_HOURS=720
# https: auto = on when the certificate exists (deploy.sh makes a self-signed one); on; off
#TLS="auto"
#TLS_CERT="/etc/homesec/tls/cert.pem"
#TLS_KEY="/etc/homesec/tls/key.pem"
# The database: index of all events and files, logins, sessions, audit log
#DB_FILE="/var/lib/homesec/homesec.db"

# ---- Storage ------------------------------------------------------------------------
#IMAGE_DIR="/var/lib/homesec"
# Delete pictures older than this many days
#KEEP_DAYS=7
#JPEG_QUALITY=90
#LOG_LEVEL="info"
